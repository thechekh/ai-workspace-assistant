# Copy to .env and adjust. All variables use the ASSISTANT_ prefix.

# --- Auth (optional) ----------------------------------------------------
# Unset = open (zero-config dev). When set: /api/* needs
# "Authorization: Bearer <token>", the UI/WS pass it via ?token=<token>
# (captured once from the URL and persisted). Production path: OIDC.
# ASSISTANT_AUTH_TOKEN=change-me

# --- LLM ----------------------------------------------------------------
# Provider: fake (offline, default — costs nothing, needs no key)
#           groq | ollama | gemini | openai
ASSISTANT_LLM_PROVIDER=fake
ASSISTANT_LLM_MODEL=llama-3.3-70b-versatile
# ASSISTANT_LLM_API_KEY=gsk_...        # Groq key from console.groq.com (free tier)
# ASSISTANT_LLM_BASE_URL=              # only to override the provider default URL

# --- Agent --------------------------------------------------------------
# Backend: custom | pydantic_ai (Phase 5) | langgraph (Phase 6)
ASSISTANT_AGENT_BACKEND=custom

# --- Embeddings / RAG ---------------------------------------------------
# Provider: hash (offline lexical hashing, default — costs nothing)
#           openai (text-embedding-3-small, ~$0.02 per 1M tokens)
#           voyage (voyage-3 — for the embedding comparison)
ASSISTANT_EMBEDDING_PROVIDER=hash
ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
# ASSISTANT_EMBEDDING_API_KEY=sk-...   # only for provider=openai
# ASSISTANT_VOYAGE_API_KEY=pa-...      # only for provider=voyage / comparison
ASSISTANT_QDRANT_COLLECTION=docs
# The knowledge base starts empty; add documents at runtime via the UI's
# Documents panel or POST /api/documents. Set this only if you want a
# folder of Markdown kept in sync (nightly job + the Re-index button):
# ASSISTANT_CORPUS_DIR=./my-docs

# Retrieval: hybrid = dense + sparse lexical (RRF fusion); the lexical
# reranker reorders the top-20. Both measurably improve golden-set recall.
ASSISTANT_RETRIEVAL_MODE=hybrid
ASSISTANT_RERANK_ENABLED=true

# --- Conversation memory ------------------------------------------------
# When the un-summarized history exceeds the budget, older turns fold into a
# rolling summary; the most recent messages stay verbatim.
ASSISTANT_HISTORY_CHAR_BUDGET=8000
ASSISTANT_HISTORY_KEEP_RECENT=6
# How long a session's transcript, summary and audit trail live in Redis.
# ASSISTANT_SESSION_TTL_SECONDS=86400

# --- Agent behaviour ----------------------------------------------------
# The system prompt steers tool choice and honesty (cite sources; never
# claim the content of a page you did not fetch; don't retry a fruitless
# search). Override it to change the assistant's persona or rules:
# ASSISTANT_SYSTEM_PROMPT="You are ..."

# debug=true (the default) also serves the minimal console at /dev.
# ASSISTANT_DEBUG=false

# --- MCP tool servers ---------------------------------------------------
# Defaults (no env needed, zero credentials): two local stdio servers —
#   code   -> regex code search over this repository
#   github -> a MOCKED GitHub server with canned PRs/issues
# Later, swap the mock for the official GitHub MCP server (needs a PAT):
# ASSISTANT_MCP_SERVERS='[{"name":"code","command":"{python}","args":["-m","assistant.mcp_servers.code_search"]},{"name":"github","command":"docker","args":["run","-i","--rm","-e","GITHUB_PERSONAL_ACCESS_TOKEN","ghcr.io/github/github-mcp-server"],"env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"ghp_..."}}]'
# ASSISTANT_MCP_ENABLED=true

# --- Infra --------------------------------------------------------------
# No Docker? Use fakeredis:// — in-memory store, zero setup (sessions don't
# survive server restarts).
ASSISTANT_REDIS_URL=redis://localhost:6379/0
ASSISTANT_QDRANT_URL=http://localhost:6333

# --- Logging & tracing --------------------------------------------------
ASSISTANT_LOG_LEVEL=INFO
ASSISTANT_LOG_JSON=false               # true -> JSON lines (production shape)
# ASSISTANT_LOG_PROMPTS=true           # dev-only: dump full prompts/completions

# Local tracing (no accounts): docker compose --profile observability up
# then Jaeger UI at http://localhost:16686, Grafana at http://localhost:3000
# ASSISTANT_OTLP_ENDPOINT=http://localhost:4318

# --- Observability cloud backends (inert until set) ----------------------
# ASSISTANT_LOGFIRE_TOKEN=              # Logfire cloud write token
# ASSISTANT_LANGFUSE_PUBLIC_KEY=pk-lf-...
# ASSISTANT_LANGFUSE_SECRET_KEY=sk-lf-...
# ASSISTANT_LANGFUSE_HOST=https://cloud.langfuse.com
